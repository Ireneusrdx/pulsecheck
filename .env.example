# --- PulseCheck server environment ---
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://pulsecheck:pulsecheck@127.0.0.1:5432/pulsecheck

# Redis connection string (optional — the app falls back to in-memory
# cache/queue implementations when Redis is unreachable)
REDIS_URL=redis://127.0.0.1:6379

# Cache / queue drivers: auto | redis | memory
CACHE_DRIVER=auto
QUEUE_DRIVER=auto

# JWT signing secret (change this in production!)
JWT_SECRET=dev-secret-change-me

# Scheduler tick in milliseconds (how often due monitors are enqueued)
SCHEDULER_TICK_MS=5000

# Set to "true" to run the HTTP API without the background scheduler
DISABLE_SCHEDULER=false
